# ADS INTELLIGENCE — Environment Variables Template
# Copy this file to .env.local and fill in your actual rotated Supabase credentials.
# NEVER commit actual credentials or service role keys to version control.

SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
NODE_ENV=development
